# Required for the cloud-only maintenance log: email-code sign-in and storage.
# Public Supabase project URL and publishable/anon key only; NEVER a service-role key.
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY

# Legacy ICU storage endpoint, used only by older clients / recovery tools.
# VITE_MAINTENANCE_STORAGE_URL=https://YOUR_PROJECT.supabase.co/functions/v1/maintenance-storage

# Optional public OAuth settings; defaults match the registered production app.
# Public Client + Require PKCE must be enabled. Never configure a frontend secret.
# VITE_INTERVALS_CLIENT_ID=2006
# VITE_INTERVALS_REDIRECT_URI=https://rueckenwind.berlin/bikeworkshopcalc/maintenance-log/
# Local/preview redirects must also be registered with Intervals.icu before use.
