# Optional shared server storage for the Intervals.icu maintenance page.
# Leave unset to keep browser-only mode. No secret belongs in a VITE_* variable.

# Only a public function URL belongs here, never an API key or service-role secret.
# VITE_MAINTENANCE_STORAGE_URL=https://YOUR_PROJECT.supabase.co/functions/v1/maintenance-storage

# The old VITE_MAINTENANCE_API_URL belongs to the unused Strava scaffold.
